# Export these variables before running; .env is not loaded automatically.
OPENAI_API_KEY=
LISTEN=127.0.0.1:8081
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Optional Google V2 settings. ADC is loaded by the SDK; no Google API key is needed.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_SPEECH_LOCATION=global
# GOOGLE_SPEECH_MODEL=short
