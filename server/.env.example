# Address to listen on. Put a TLS-terminating reverse proxy in front of it:
# passkeys only work over HTTPS (or on http://localhost).
LISTEN=127.0.0.1:8080
# URL the app is reached at. Passkeys are bound to its host, so do not change it later.
PUBLIC_ORIGIN=https://qso.example.com
# The built web app (cd web && npm run build).
WEB_DIR=../web/build
# SQLite database (users, passkeys, sessions, stations, QSOs).
DATABASE_PATH=./data/speech-to-qso.db
