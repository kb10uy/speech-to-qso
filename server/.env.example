# Address to listen on. Put a TLS-terminating reverse proxy in front of it:
# the GitHub Pages client is served over HTTPS and cannot call plain HTTP APIs.
LISTEN=127.0.0.1:8080
# Bearer token the web client sends (Settings → API token).
API_TOKEN=change-me
# Comma-separated CORS origins; empty allows any origin.
ALLOWED_ORIGINS=https://kb10uy.github.io
# Append-only QSO logs (qsos.jsonl, log.adi).
DATA_DIR=./data
# Optional Wavelog forwarding.
WAVELOG_URL=https://log.example.com
WAVELOG_API_KEY=
WAVELOG_STATION_ID=1
